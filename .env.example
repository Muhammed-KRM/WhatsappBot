# WhatsApp Kafe Otomasyon - Ortam Değişkenleri
# Bu dosyayı kopyalayarak .env oluşturun:
#   cp .env.example .env
# Ardından değerleri kendi API anahtarlarınızla doldurun.

# Evolution API Anahtarı
# WhatsApp bağlantısını yönetmek için kullanılan Evolution API'nin kimlik doğrulama anahtarı.
# Güvenli ve tahmin edilmesi zor bir değer seçin (örn: openssl rand -hex 32).
EVOLUTION_API_KEY=your-secure-evolution-api-key-here

# Google Gemini API Anahtarı
# Vardiya mesajlarını yapay zeka ile ayrıştırmak için kullanılan Gemini API anahtarı.
# https://aistudio.google.com/app/apikey adresinden ücretsiz alabilirsiniz.
GEMINI_API_KEY=your-gemini-api-key-here
