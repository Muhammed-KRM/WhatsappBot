@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using CafeBot.Business.DTOs
@using CafeBot.Data.Enums
@inject ApiService ApiService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<Index> Logger
@implements IDisposable

<PageTitle>CafeBot Dashboard</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <!-- Giriş yapmamış kullanıcılar için hero section -->
        <div class="hero-section bg-primary text-white py-5 mb-5">
            <div class="container text-center">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <h1 class="display-4 fw-bold mb-4">
                            <span class="me-3">☕</span>CafeBot
                        </h1>
                        <p class="lead mb-4">
                            WhatsApp gruplarınızdaki vardiya mesajlarını otomatik olarak algılayıp, 
                            belirlediğiniz öncelik sırasına göre uygun saati yanıtlayan akıllı otomasyon sistemi.
                        </p>
                        <div class="d-flex gap-3 justify-content-center flex-wrap">
                            <a href="/login" class="btn btn-light btn-lg px-4">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                Giriş Yap
                            </a>
                            <a href="/register" class="btn btn-outline-light btn-lg px-4">
                                <i class="bi bi-person-plus me-2"></i>
                                Kayıt Ol
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Özellikler bölümü -->
        <div class="container mb-5">
            <div class="row">
                <div class="col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <i class="bi bi-robot" style="font-size: 1.5rem;"></i>
                            </div>
                            <h5 class="card-title">Yapay Zeka Destekli</h5>
                            <p class="card-text text-muted">Google Gemini AI ile WhatsApp mesajlarını anlayıp otomatik yanıt verir.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <i class="bi bi-clock" style="font-size: 1.5rem;"></i>
                            </div>
                            <h5 class="card-title">Öncelik Sistemi</h5>
                            <p class="card-text text-muted">Kendi öncelik listenizi oluşturun, bot en uygun saati otomatik seçsin.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                <i class="bi bi-shield-check" style="font-size: 1.5rem;"></i>
                            </div>
                            <h5 class="card-title">Güvenli & Hızlı</h5>
                            <p class="card-text text-muted">Kendi API anahtarınızla güvenli, hızlı ve kesintisiz kullanım.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>
    <Authorized>
        <!-- Giriş yapmış kullanıcılar için dashboard -->
        <div class="container">
            <h2 class="mb-4">CafeBot Dashboard</h2>

            @if (isLoading)
            {
                <div class="text-center my-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                    <p class="mt-2 text-muted">Dashboard yükleniyor...</p>
                </div>
            }
            else if (showApiKeyRequired)
            {
                <!-- API Key Gerekli Uyarısı -->
                <div class="alert alert-warning border-0 shadow-sm">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill me-3" style="font-size: 1.5rem;"></i>
                        <div class="flex-grow-1">
                            <h5 class="alert-heading mb-1">API Anahtarı Gerekli</h5>
                            <p class="mb-2">CafeBot'u kullanmak için Google Gemini API anahtarınızı girmeniz gerekiyor.</p>
                            <div class="d-flex gap-2">
                                <button class="btn btn-warning btn-sm" @onclick="GoToApiKeySetup">
                                    <i class="bi bi-key me-1"></i> API Anahtarını Ayarla
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="CheckApiKeyStatus">
                                    <i class="bi bi-arrow-clockwise me-1"></i> Yenile
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Dashboard İçeriği -->
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible">
                        @errorMessage
                        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success alert-dismissible">
                        @successMessage
                        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                    </div>
                }

                @if (config != null)
                {
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary">Sistem Durumu</h6>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6>WhatsApp Bağlantısı</h6>
                                            <span class="badge @(config.ConnectionStatus == ConnectionStatus.Connected ? "bg-success" : "bg-danger")">
                                                @config.ConnectionStatus
                                            </span>
                                        </div>
                                        <div class="col-md-6">
                                            <h6>Sistem Durumu</h6>
                                            <span class="badge @(config.SystemStatus == SystemStatus.Running ? "bg-success" : "bg-warning")">
                                                @config.SystemStatus
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary">Hızlı İşlemler</h6>
                                </div>
                                <div class="card-body">
                                    <div class="d-grid gap-2">
                                        @if (config.SystemStatus == SystemStatus.Stopped)
                                        {
                                            <button class="btn btn-success btn-sm mb-2" @onclick="() => ToggleSystemStatus(SystemStatus.Running)">
                                                <i class="bi bi-play-fill me-1"></i> Sistemi Başlat
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-warning btn-sm mb-2" @onclick="() => ToggleSystemStatus(SystemStatus.Stopped)">
                                                <i class="bi bi-stop-fill me-1"></i> Sistemi Durdur
                                            </button>
                                        }
                                        <a href="/connection" class="btn btn-primary btn-sm">
                                            <i class="bi bi-qr-code me-1"></i> QR Kod Al
                                        </a>
                                        <a href="/group-selection" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-people me-1"></i> Grup Seç
                                        </a>
                                        <a href="/priority" class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-list-ol me-1"></i> Öncelik Ayarla
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (recentLogs != null && recentLogs.Count > 0)
                    {
                        <div class="card shadow mb-4">
                            <div class="card-header py-3">
                                <h6 class="m-0 font-weight-bold text-primary">Son Aktiviteler</h6>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Zaman</th>
                                                <th>Tip</th>
                                                <th>Mesaj</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var log in recentLogs)
                                            {
                                                <tr>
                                                    <td>@log.Timestamp.ToString("HH:mm:ss")</td>
                                                    <td>
                                                        <span class="badge bg-secondary">@log.Type</span>
                                                    </td>
                                                    <td>@log.Message</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private ConfigDto? config;
    private List<ActivityLogDto>? recentLogs;
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = true;
    private bool showApiKeyRequired = false;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Logger.LogInformation("🚀 Index.OnAfterRenderAsync(firstRender=true) - CheckApiKeyStatus çağrılıyor");
            await CheckApiKeyStatus();
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (e.Location.EndsWith("/") || e.Location.EndsWith("/index"))
        {
            await InvokeAsync(CheckApiKeyStatus);
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task CheckApiKeyStatus()
    {
        Logger.LogInformation("🔍 CheckApiKeyStatus BAŞLADI");

        try
        {
            isLoading = true;
            errorMessage = null;
            successMessage = null;
            StateHasChanged();

            Logger.LogInformation("📡 GetProfileAsync çağrılıyor...");
            var (profileData, profileError) = await ApiService.GetProfileAsync();

            Logger.LogInformation("📡 GetProfileAsync döndü - Error: {Error}, Data: {Data}",
                profileError ?? "null",
                profileData == null ? "null" : $"Email={profileData.Email}");

            if (!string.IsNullOrEmpty(profileError))
            {
                Logger.LogWarning("❌ Profil hatası: {Error}", profileError);
                errorMessage = $"Profil alınamadı: {profileError}";
                showApiKeyRequired = true;
                return;
            }

            if (profileData == null)
            {
                Logger.LogWarning("❌ profileData null döndü");
                errorMessage = "Profil bilgileri alınamadı.";
                showApiKeyRequired = true;
                return;
            }

            bool hasApiKey = !string.IsNullOrWhiteSpace(profileData.PersonalGeminiApiKey);
            Logger.LogInformation("🔑 hasApiKey={HasApiKey}, ApiKeyLength={Length}",
                hasApiKey,
                profileData.PersonalGeminiApiKey?.Length ?? 0);

            if (hasApiKey)
            {
                Logger.LogInformation("✅ API Key VAR - showApiKeyRequired=false, dashboard yükleniyor");
                showApiKeyRequired = false;
                await LoadDashboardData();
            }
            else
            {
                Logger.LogInformation("❌ API Key YOK - showApiKeyRequired=true");
                showApiKeyRequired = true;
            }

            Logger.LogInformation("🏁 CheckApiKeyStatus TAMAMLANDI - showApiKeyRequired={Value}", showApiKeyRequired);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "💥 CheckApiKeyStatus EXCEPTION");
            errorMessage = $"Hata: {ex.Message}";
            showApiKeyRequired = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadDashboardData()
    {
        try
        {
            var configTask = ApiService.GetConfig();
            var logsTask = ApiService.GetActivityLogs(1, 5);
            await Task.WhenAll(configTask, logsTask);

            var (configData, configError) = await configTask;
            var (logsData, logsError) = await logsTask;

            if (configError != null) errorMessage = configError;
            else config = configData;

            if (logsError != null && string.IsNullOrEmpty(errorMessage)) errorMessage = logsError;
            else if (logsData != null) recentLogs = logsData;
        }
        catch (Exception ex)
        {
            errorMessage = $"Dashboard verileri yüklenemedi: {ex.Message}";
        }
    }

    private void GoToApiKeySetup()
    {
        NavigationManager.NavigateTo("/api-key-setup");
    }

    private async Task RefreshPage()
    {
        successMessage = "Yenileniyor...";
        StateHasChanged();
        await CheckApiKeyStatus();
    }

    private async Task LogToConsole(string message)
    {
        try { await JSRuntime.InvokeVoidAsync("console.log", $"[{DateTime.Now:HH:mm:ss.fff}] {message}"); }
        catch { }
    }

    private async Task ToggleSystemStatus(SystemStatus newStatus)
    {
        try
        {
            var error = await ApiService.UpdateSystemStatus(newStatus);
            if (error != null)
            {
                errorMessage = error;
            }
            else
            {
                successMessage = $"Sistem durumu '{newStatus}' olarak güncellendi.";
                // Refresh config from server to get updated state
                await LoadDashboardData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Hata: {ex.Message}";
        }
        StateHasChanged();
    }
}