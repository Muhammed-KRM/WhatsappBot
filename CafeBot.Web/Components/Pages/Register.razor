@page "/register"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using CafeBot.Business.DTOs
@using CafeBot.Web.Auth
@inject ApiService ApiService
@inject TokenAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Kayıt Ol</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-sm" style="width: 100%; max-width: 450px; border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-dark text-white text-center py-4 border-0">
            <h3 class="mb-0 fw-bold">🚀 Yeni Hesap</h3>
            <p class="mb-0 text-white-50 small mt-1">Sisteme Kiracı Olarak Katılın</p>
        </div>
        <div class="card-body p-4">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger p-2 mb-3 small">@errorMessage</div>
            }

            <EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
                <DataAnnotationsValidator />
                
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Kafe / İşletme Adı</label>
                    <InputText @bind-Value="registerModel.CompanyName" class="form-control bg-light" placeholder="Örn: Starbucks Kadıköy" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">E-Posta Adresi</label>
                    <InputText @bind-Value="registerModel.Email" type="email" class="form-control bg-light" placeholder="ornek@cafe.com" required />
                </div>
                
                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">Şifre</label>
                    <InputText @bind-Value="registerModel.Password" type="password" class="form-control bg-light" placeholder="••••••••" required />
                    <div class="form-text small">En az 6 karakter olmalıdır.</div>
                </div>

                <button type="submit" class="btn btn-dark w-100 py-2 fw-bold" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    Hesap Oluştur
                </button>
            </EditForm>
        </div>
        <div class="card-footer bg-transparent text-center border-0 pb-4 pt-0">
            <p class="text-muted small mb-0">Zaten hesabınız var mı? <a href="/login" class="text-decoration-none fw-bold">Giriş Yapın</a></p>
        </div>
    </div>
</div>

@code {
    private RegisterRequestDto registerModel = new RegisterRequestDto { Email = "", Password = "", CompanyName = "" };
    private bool isLoading;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;

        var (response, error) = await ApiService.RegisterAsync(registerModel);

        if (error != null || response == null)
        {
            errorMessage = error ?? "Kayıt işlemi başarısız oldu.";
        }
        else
        {
            // Kayıt başarılı → Login sayfasına yönlendir (otomatik giriş yapmıyoruz)
            NavigationManager.NavigateTo("/login?registered=true");
        }

        isLoading = false;
    }
}
